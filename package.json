    "@radix-ui/react-tooltip": "1.1.8",
    "@supabase/supabase-js": "^2.98.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cors": "^2.8.6",
    "date-fns": "3.6.0",
    "dotenv": "^17.3.1",
    "embla-carousel-react": "8.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "input-otp": "1.4.2",
    "js-yaml": "^5.2.1",
    "jspdf": "^2.5.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
