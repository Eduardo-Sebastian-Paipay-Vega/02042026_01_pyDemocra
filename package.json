{
  "name": "vanilla-migrated",
  "private": true,
  "version": "1.0.0",
  "author": "EDUARDO SEBASTIAN PAIPAY VEGA <paipayvegabastian@gmail.com> (democra.pro)",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:web": "vite --force",
    "dev:api": "node server/index.js",
    "clean:ports": "node scripts/clean-ports.mjs",
    "clean:cache": "node scripts/clean-cache.mjs",
    "clean": "node scripts/clean-ports.mjs && node scripts/clean-cache.mjs",
    "clean:build": "npx rimraf node_modules/.vite dist",
    "dev:force": "npm run clean:build && vite --force",
    "predev:all": "node scripts/clean-ports.mjs && node scripts/clean-cache.mjs && node scripts/startup-banner.mjs",
    "dev:all": "concurrently --kill-others-on-fail --names \"API,WEB\" -c \"bgBlue.bold,bgGreen.bold\" \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "node server/index.js",
    "docs": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "validate": "node scripts/validate-env.mjs",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:web": "vitest run",
    "test:web:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
