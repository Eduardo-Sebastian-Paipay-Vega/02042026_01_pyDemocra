{
  "name": "vanilla-migrated",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:web": "vite --force",
    "dev:api": "node server/index.js",
    "clean:ports": "node scripts/clean-ports.mjs",
    "clean:cache": "node scripts/clean-cache.mjs",
    "clean": "node scripts/clean-ports.mjs && node scripts/clean-cache.mjs",
    "clean:build": "npx rimraf node_modules/.vite dist",
    "dev:force": "npm run clean:build && vite --force",
    "predev:all": "node scripts/clean-ports.mjs && node scripts/clean-cache.mjs && node scripts/startup-banner.mjs",
    "dev:all": "concurrently --kill-others-on-fail --names \"API,WEB\" -c \"bgBlue.bold,bgGreen.bold\" \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "node server/index.js",
    "docs": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-env.mjs",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:web": "vitest run",
    "test:web:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-jest": "^30.4.1",
    "concurrently": "^9.2.1",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "6.3.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
