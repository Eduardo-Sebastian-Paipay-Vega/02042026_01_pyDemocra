# Variables para Playwright (tests/e2e). Copiar a .env.e2e (ignorado por git,
# ver .gitignore: .env* con excepción de *.example) y completar.
#
# No confundir con .env.example (secretos server-side que Playwright no usa).

# URL contra la que corren las pruebas. Por defecto apunta al Vite dev server
# local (http://localhost:5173) que playwright.config.ts levanta solo.
# E2E_BASE_URL=http://localhost:5173

# Usuario de prueba real, seedeado en el proyecto Supabase de sandbox
# (ver dds/fases/fase_6_qa_y_testing/e2e/pruebas/01-plan-e2e.md, sección
# "Seed Data"). Sin estas dos variables, el test de login exitoso se omite
# automáticamente — el resto de la suite sigue corriendo.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
