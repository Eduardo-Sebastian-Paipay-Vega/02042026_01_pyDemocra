# Frontend (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend API
API_PORT=8787
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ONG module (mismo proyecto Supabase de arriba — ver ONG/src/lib/db/core.ts)
ONG_DB_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ONG_DB_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
ONG_DB_SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_ONG_DB_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_ONG_DB_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# RUC validation (SUNAT provider)
# Supports placeholders {ruc} and {token} or :ruc and :token
# Example valid URL:
# https://api.apis.net.pe/v2/sunat/ruc/full?numero={ruc}&token={token}
VITE_RUC_API_URL=https://api.apis.net.pe/v2/sunat/ruc/full?numero={ruc}&token={token}
RUC_API_TOKEN=YOUR_RUC_API_TOKEN

# Security / MFA
MFA_OTP_PEPPER=CHANGE_ME_FOR_PRODUCTION
MFA_OTP_TTL_MINUTES=10
SESSION_TTL_HOURS=8
MAX_PIN_ATTEMPTS=5
PIN_BLOCK_MINUTES=15
RISK_TEMP_BLOCK_MINUTES=15
EXPOSE_DEBUG_OTP=false

# OTP Email delivery
# Use "resend" for real delivery. Use "none" with EXPOSE_DEBUG_OTP=true for local testing.
OTP_EMAIL_PROVIDER=resend
OTP_FROM_EMAIL=security@yourdomain.com
OTP_FROM_NAME=Solaris Security
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
OTP_RESEND_API_URL=https://api.resend.com/emails

# Optional (legacy AI fields - not used for risk decisions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
