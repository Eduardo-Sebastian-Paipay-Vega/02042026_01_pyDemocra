# =============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — DEMOCRA MONOREPO
# =============================================================================

# Frontend (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend API & Serverless Adapter
API_PORT=8787
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Módulo ONG / Platform (Mismo proyecto Supabase)
ONG_DB_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ONG_DB_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
ONG_DB_SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_ONG_DB_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_ONG_DB_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Validación de RUC (Proveedor SUNAT)
VITE_RUC_API_URL=https://api.apis.net.pe/v2/sunat/ruc/full?numero={ruc}&token={token}
RUC_API_TOKEN=YOUR_RUC_API_TOKEN

# Cifrado AES-256 & Criptografía HMAC (M01 & M13)
MFA_OTP_PEPPER=CHANGE_ME_FOR_PRODUCTION_AES256_PEPPER
HMAC_QR_SECRET_KEY=CHANGE_ME_FOR_ROTATIVE_HMAC_QR
MFA_OTP_TTL_MINUTES=10
SESSION_TTL_HOURS=8
MAX_PIN_ATTEMPTS=5
PIN_BLOCK_MINUTES=15
RISK_TEMP_BLOCK_MINUTES=15
EXPOSE_DEBUG_OTP=false

# Notificaciones Multicanal (M09)
OTP_EMAIL_PROVIDER=resend
OTP_FROM_EMAIL=security@democra.org
OTP_FROM_NAME=Democra Platform
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# WhatsApp (Meta Cloud API / Twilio)
META_WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
META_WHATSAPP_PHONE_ID=1009876543210

# SMS (Twilio / AWS SNS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12345678901
AWS_SNS_REGION=us-east-1

# Push Notifications (Firebase Cloud Messaging FCM HTTP v1)
FCM_SERVER_KEY=AAAAxxxxxxxxxxxxxxxxxxxxxxxx
FCM_PROJECT_ID=democra-app

# Pasarelas de Pago & Webhooks (M14)
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
CULQI_PRIVATE_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# SSO Empresarial SAML 2.0 / Entra ID (M10)
SAML_IDP_ISSUER=https://identity.company.com
SAML_ENTRY_POINT=https://login.microsoftonline.com/tenant-id/saml2
SAML_CERT_PEM="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"

# OCR & Análisis de Documentos (M02)
OCR_VISION_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx

# AI / Copilot (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
