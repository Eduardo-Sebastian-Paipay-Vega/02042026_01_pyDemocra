# WhatsApp (Meta Cloud API / Twilio)
META_WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
META_WHATSAPP_PHONE_ID=1009876543210

# SMS (Twilio / AWS SNS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12345678901
AWS_SNS_REGION=us-east-1

# Push Notifications (Firebase Cloud Messaging FCM HTTP v1)
FCM_SERVER_KEY=AAAAxxxxxxxxxxxxxxxxxxxxxxxx
FCM_PROJECT_ID=democra-app

# Pasarelas de Pago & Webhooks (M14)
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
CULQI_PRIVATE_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
