# Validación de RUC (Proveedor SUNAT)
VITE_RUC_API_URL=https://api.apis.net.pe/v2/sunat/ruc/full?numero={ruc}&token={token}
RUC_API_TOKEN=YOUR_RUC_API_TOKEN

# Cifrado AES-256 & Criptografía HMAC (M01 & M13)
MFA_OTP_PEPPER=CHANGE_ME_FOR_PRODUCTION_AES256_PEPPER
HMAC_QR_SECRET_KEY=CHANGE_ME_FOR_ROTATIVE_HMAC_QR
MFA_OTP_TTL_MINUTES=10
SESSION_TTL_HOURS=8
MAX_PIN_ATTEMPTS=5
PIN_BLOCK_MINUTES=15
RISK_TEMP_BLOCK_MINUTES=15
EXPOSE_DEBUG_OTP=false

# Notificaciones Multicanal (M09)
OTP_EMAIL_PROVIDER=resend
OTP_FROM_EMAIL=security@democra.org
OTP_FROM_NAME=Democra Platform
