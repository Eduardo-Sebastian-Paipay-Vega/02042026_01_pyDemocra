// EDUCACION OS — DATABASE SCHEMA (DDS FASE 5 POSTGRESQL RLS)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  TENANT_OWNER
  DIRECTOR_USER
  ACADEMIC_ADMIN
  COORDINATOR_USER
  TEACHER_USER
  STUDENT_USER
  PARENT_USER
  TUTOR_USER
  FINANCE_ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EwsRiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH_RISK_DROPOUT
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  courses Course[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  roles     Role[]   @default([STUDENT_USER])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Course {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  code              String
  title             String
  description       String?
  gradeLevel        String       @map("grade_level")
  status            CourseStatus @default(DRAFT)
  assignedTeacherId String?      @map("assigned_teacher_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("courses")
}

model EwsRiskAlert {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  studentId       String       @map("student_id")
  riskScore       Float        @map("risk_score")
  riskLevel       EwsRiskLevel @default(NONE) @map("risk_level")
  triggerFactors  String[]     @map("trigger_factors")
  suggestedAction String       @map("suggested_action")
  isIntervened    Boolean      @default(false) @map("is_intervened")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("ews_risk_alerts")
}
